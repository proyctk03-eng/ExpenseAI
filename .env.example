# PostgreSQL Database URL (Ví dụ: postgresql://postgres:123456@db:5432/expense_db)
DATABASE_URL=postgresql://user:password@localhost:5432/expense_db

# Secret key for JWT Token generation (Sử dụng lệnh `openssl rand -hex 32` để tạo)
SECRET_KEY=your_secret_key_here

# Thuật toán mã hóa JWT
ALGORITHM=HS256

# Thời gian sống của JWT Token (phút)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI API Key for AI features (Lấy từ OpenAI Dashboard)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key for AI features (Lấy từ Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Môi trường chạy (development hoặc production)
ENVIRONMENT=development
