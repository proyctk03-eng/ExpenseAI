# Chọn ít nhất một nhà cung cấp AI. Gemini được ưu tiên khi cả hai cùng tồn tại.
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
OPENAI_API_KEY=

# Bắt buộc thay bằng giá trị ngẫu nhiên mạnh khi triển khai production.
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./expense_db.sqlite
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=30
